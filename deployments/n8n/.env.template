# n8n Settings
DOMAIN_NAME=margusm.dev
SUBDOMAIN=n8n
GENERIC_TIMEZONE=Europe/Tallinn
N8N_HOST=n8n.margusm.dev
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.margusm.dev/
# N8N_SECURE_COOKIE=false
NODE_ENV=production

# Task runners — external mode, runner sidecar connects to the broker on n8n:5679
N8N_RUNNERS_MODE=external
N8N_RUNNERS_BROKER_LISTEN_ADDRESS=0.0.0.0
N8N_RUNNERS_AUTH_TOKEN=${GITLAB_N8N_RUNNERS_AUTH_TOKEN}

# PostgreSQL
POSTGRES_DB=${GITLAB_POSTGRES_DB}
POSTGRES_USER=${GITLAB_POSTGRES_USER}
POSTGRES_PASSWORD=${GITLAB_POSTGRES_PASSWORD}

# n8n database connection (n8n does not read POSTGRES_* — without these it falls back to SQLite)
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=${GITLAB_POSTGRES_DB}
DB_POSTGRESDB_USER=${GITLAB_POSTGRES_USER}
DB_POSTGRESDB_PASSWORD=${GITLAB_POSTGRES_PASSWORD}
